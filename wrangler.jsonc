// Cloudflare Workers config. Deployed by Workers Builds on every push to main.
// Custom domains (malachek.com and the role subdomains) are added only at the
// DNS cutover step, after Malachy's explicit go. Until then: *.workers.dev preview.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "malachek-portfolio",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "observability": { "enabled": true }
}
