---
/**
 * Generalist project pages at their original Figma Sites paths (/exo,
 * /the-fallen, ...), so links already sent to recruiters keep working.
 * Other roles: src/pages/[role]/[project].astro.
 */
import ProjectPage from '@/layouts/ProjectPage.astro';
import { APEX_ROLE, absUrl, getRole, rolePages } from '@/lib/content';

export async function getStaticPaths() {
  const pages = await rolePages(APEX_ROLE);
  return pages.map((page) => ({ params: { project: page.path!.slice(1) }, props: { page } }));
}

const { page } = Astro.props;
const role = await getRole(APEX_ROLE);
---
<ProjectPage page={page} roleId={APEX_ROLE} canonical={absUrl(role, page.path!)} />
