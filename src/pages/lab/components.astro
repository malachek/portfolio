---
/**
 * DEV ONLY: every component with sample content, for checking against the Figma
 * frames at 1280 / 800 / 374. Stripped from production builds (astro.config.mjs).
 * Sample text is taken from the Figma file itself; real page copy comes from
 * 18-FINAL-COPY.md in build step 2.
 */
import Base from '@/layouts/Base.astro';
import ProjectHero from '@/components/project/ProjectHero.astro';
import OverviewCapsule from '@/components/project/OverviewCapsule.astro';
import Section from '@/components/layout/Section.astro';
import Capsule from '@/components/layout/Capsule.astro';
import SubsectionHeading from '@/components/layout/SubsectionHeading.astro';
import GroupHeading from '@/components/layout/GroupHeading.astro';
import Lead from '@/components/layout/Lead.astro';
import MediaRow from '@/components/media/MediaRow.astro';
import Media from '@/components/media/Media.astro';
import LinkPill from '@/components/project/LinkPill.astro';
import FeatureCard from '@/components/home/FeatureCard.astro';
import AlsoBuilt from '@/components/home/AlsoBuilt.astro';
import Skills from '@/components/home/Skills.astro';
import { placeholderArt } from '@/lib/placeholder';

const art = placeholderArt;
const bg = art('#2a0c3f', '#0b1a3a');
---
<Base title="Components (dev)" description="Component showcase" noindex>
  <ProjectHero
    title="EXO"
    background={bg}
    lines={[
      'Third-person movement shooter on spherical planets, where speed is the weapon.',
      'Game Engineer & Tech Lead · Sole programmer on a team of 11 · Unreal Engine 5.6',
      '3rd Place, ICS Project Expo · Approved on Steam',
    ]}
  />

  <OverviewCapsule
    rows={[
      { label: 'Type', value: 'Team Project · 11 developers' },
      { label: 'Genre', value: '3rd Person Action Shooter' },
      { label: 'Role', value: 'Game Engineer & Tech Lead' },
      { label: 'Duration', value: 'August 2025 - Present' },
      { label: 'Engine', value: 'Unreal Engine 5.6' },
      { label: 'Tools', value: 'C++, UE5 Blueprints, GAS, Perforce' },
      { label: 'Status', value: 'Approved on Steam.' },
    ]}
    steamAppIds={[4587490]}
    code={{ href: 'https://github.com/malachek/EXO_CodeSamples', label: 'github.com/malachek/EXO_CodeSamples' }}
  />

  <Section heading="Project Description">
    <Capsule>
      <div class="prose">
        <p>EXO is a third-person movement shooter set on spherical planets, where speed is the weapon.</p>
        <p>Players orbit, leap between planets, and chain high-velocity maneuvers, shooting enemies and tearing out their souls to use as fuel.</p>
        <p>Every system in it answers one question: how do you make a game feel as fast as it is without making it as hard as it is?</p>
      </div>
    </Capsule>
    <Capsule media>
      <MediaRow cols={1}>
        <Media alt="Placeholder: spherical traversal clip" caption="Spherical traversal at high speeds" />
      </MediaRow>
    </Capsule>
  </Section>

  <Section heading="What I Built">
    <Lead>Sole programmer. Every system below is mine.</Lead>
    <GroupHeading eyebrow="What I Built" title="Movement & Camera" />
    <SubsectionHeading>Movement &amp; Physics</SubsectionHeading>
    <Capsule>
      <p class="prose">Rebuilt from the velocity model up, because the stock one breaks at speed.</p>
    </Capsule>
    <Capsule>
      <ul class="bullets">
        <li>Spherical force component: a named force registry with parallel transport, impulse and continuous forces</li>
        <li>Two-channel velocity model separating player steering from external forces</li>
        <li>Force damping with an exponential-tail cutoff</li>
      </ul>
    </Capsule>
    <Capsule media>
      <MediaRow cols={3}>
        <Media alt="Placeholder clip 1" caption="Large spherical force wrapping around the planet." />
        <Media alt="Placeholder clip 2" caption="Entering Overdrive" />
        <Media alt="Placeholder clip 3" caption="Spherical force component: Jump, Dash, Jump and Dash" />
      </MediaRow>
    </Capsule>
    <Capsule media>
      <MediaRow cols={2}>
        <Media alt="Placeholder clip A" caption="Two-up row" />
        <Media alt="Placeholder clip B" caption="Two-up row" />
      </MediaRow>
    </Capsule>
    <div class="center">
      <LinkPill href="https://github.com/malachek/EXO_CodeSamples" size="code" underline>github.com/malachek/EXO_CodeSamples</LinkPill>
    </div>
  </Section>

  <div id="projects" class="stack">
    <FeatureCard
      category="Game Project"
      dates="Aug 2025 - Present"
      title="EXO"
      href="/exo"
      accent="#D52FC7"
      background={art('#1d0833', '#3a0f2e')}
      links={[
        { icon: 'github', href: 'https://github.com/malachek/EXO_CodeSamples', label: 'EXO code samples on GitHub' },
        { icon: 'steam', href: 'https://store.steampowered.com/app/4587490/EXO', label: 'EXO on Steam' },
      ]}
      chips={['Unreal Engine 5.6', 'C++', 'UE5 Blueprints', 'Perforce', 'Wwise', 'GAS']}
      bullets={['Sample bullet one', 'Sample bullet two', 'Sample bullet three']}
      media={{ kind: 'image', src: art('#3b0f3a', '#0b1a3a'), alt: 'Placeholder: EXO clip' }}
      blurb="Sample blurb under the clip."
    />
    <FeatureCard
      kind="experience"
      category="Studio"
      dates="Apr 2024 - Present"
      title="Game Engineer"
      org="Burnt Out Games"
      href="/burnt-out-games-llc"
      accent="#F05C23"
      background={art('#2a0e05', '#140502')}
      chips={['Unreal Engine 5.6', 'Unity 6', 'Perforce']}
      bullets={['Sample bullet one', 'Sample bullet two']}
      media={{ kind: 'image', src: art('#2a0e05', '#140502'), alt: 'Placeholder: studio logo' }}
      blurb="Sample blurb."
    />
  </div>

  <AlsoBuilt
    dates="Jan 2025 - Sep 2026"
    cards={[
      { title: 'Night Walk', blurb: 'Sample blurb.', accent: '#43792E', media: { alt: 'Placeholder' } },
      { title: 'Loonage', blurb: 'Sample blurb.', accent: '#86BE3A', media: { alt: 'Placeholder' } },
      { title: 'Limital', blurb: 'Sample blurb.', accent: '#60788D', media: { alt: 'Placeholder' },
        links: [{ icon: 'globe', href: 'https://devpost.com/software/limital', label: 'Limital case study' }] },
    ]}
    more={{ text: 'Everything else →', href: 'https://malachek.itch.io/', label: 'malachek.itch.io' }}
  />

  <Skills
    groups={[
      { label: 'Languages', items: ['C++', 'C#', 'Python', 'UE5 Blueprints'] },
      { label: 'Engines & Tools', items: ['Unreal Engine 5', 'Unity 6', 'Perforce', 'Git'] },
    ]}
  />
</Base>

<style>
  .center { display: flex; justify-content: center; }
  .stack { display: flex; flex-direction: column; gap: 24px; padding-bottom: 24px; }
</style>
