---
/**
 * DEV ONLY: alternate layouts for the top of the homepage (site header + role
 * switcher), each shown at full width with the start of the hero under it.
 * http://localhost:4321/lab/header-options — resize the window to see phone layouts.
 */
import Base from '@/layouts/Base.astro';
import Icon from '@/components/icons/Icon.astro';
import { getRoles, roleBase } from '@/lib/content';

const roles = (await getRoles()).filter((r) => r.data.enabled);
const current = 'gameplay';
const cur = roles.find((r) => r.id === current)!;
---
<Base title="Header options (dev)" description="Header layout proposals" noindex>
  <div class="intro wrap">
    <h1 class="display">Header options</h1>
    <p>Each option shows the top of the Gameplay homepage. The real header above this text is option A (current). Resize the window to check phone widths.</p>
  </div>

  <!-- B -->
  <p class="label">Option B · One bar: role tabs sit inside the header, centered</p>
  <div class="demo">
    <div class="hb">
      <a class="hb__name eyebrow" href="#">Malachy Kennedy</a>
      <nav class="hb__tabs" aria-label="Portfolio focus (demo)">
        {roles.map((r) => <a href="#" aria-current={r.id === current ? 'page' : undefined}>{r.data.label}</a>)}
      </nav>
      <div class="hb__right">
        <a class="eyebrow" href="#">Projects</a><a class="eyebrow" href="#">Resume</a>
        <a class="ic" href="#"><Icon name="github" size={20} label="GitHub" /></a><a class="ic" href="#"><Icon name="linkedin" size={20} label="LinkedIn" /></a>
      </div>
    </div>
    <div class="stub"></div>
  </div>

  <!-- C -->
  <p class="label">Option C · Breadcrumb: "Malachy Kennedy / Gameplay ▾" with the other focuses in a menu</p>
  <div class="demo">
    <div class="hc">
      <div class="hc__crumb">
        <a class="hc__name" href="#">Malachy Kennedy</a>
        <span class="hc__slash" aria-hidden="true">/</span>
        <details class="hc__menu">
          <summary>{cur.data.label}<span aria-hidden="true"> ▾</span></summary>
          <ul role="list">
            {roles.map((r) => <li><a href="#" aria-current={r.id === current ? 'page' : undefined}>{r.data.label}<small>{r.data.host}</small></a></li>)}
          </ul>
        </details>
      </div>
      <div class="hb__right">
        <a class="eyebrow" href="#">Projects</a><a class="eyebrow" href="#">Resume</a>
        <a class="ic" href="#"><Icon name="github" size={20} label="GitHub" /></a><a class="ic" href="#"><Icon name="linkedin" size={20} label="LinkedIn" /></a>
      </div>
    </div>
    <div class="stub"></div>
  </div>

  <!-- D -->
  <p class="label">Option D · Underline tabs under a slim header, in the page accent (no pills)</p>
  <div class="demo">
    <div class="hd">
      <div class="hd__top">
        <a class="hb__name eyebrow" href="#">Malachy Kennedy</a>
        <div class="hb__right">
          <a class="eyebrow" href="#">Projects</a><a class="eyebrow" href="#">Resume</a>
          <a class="ic" href="#"><Icon name="github" size={20} label="GitHub" /></a><a class="ic" href="#"><Icon name="linkedin" size={20} label="LinkedIn" /></a>
        </div>
      </div>
      <nav class="hd__tabs" aria-label="Portfolio focus (demo)">
        {roles.map((r) => <a href="#" aria-current={r.id === current ? 'page' : undefined}>{r.data.label}</a>)}
      </nav>
    </div>
    <div class="stub"></div>
  </div>

  <!-- E -->
  <p class="label">Option E · Switcher lives in the hero: "Viewing as" chips under your name, header stays minimal</p>
  <div class="demo">
    <div class="hd__top he">
      <a class="hb__name eyebrow" href="#">Malachy Kennedy</a>
      <div class="hb__right">
        <a class="eyebrow" href="#">Projects</a><a class="eyebrow" href="#">Resume</a>
        <a class="ic" href="#"><Icon name="github" size={20} label="GitHub" /></a><a class="ic" href="#"><Icon name="linkedin" size={20} label="LinkedIn" /></a>
      </div>
    </div>
    <div class="stub stub--hero">
      <div class="stub__card">
        <p class="display stub__name">Malachy Kennedy</p>
        <div class="he__chips">
          <span>Showing work for</span>
          {roles.map((r) => <a href="#" aria-current={r.id === current ? 'page' : undefined}>{r.data.label}</a>)}
        </div>
        <p class="stub__line">Gameplay engineer with shipped UE5 and Unity titles on Steam…</p>
      </div>
    </div>
  </div>
</Base>

<style>
  .intro { padding-block: 32px 8px; }
  .intro p { margin-top: 8px; color: var(--text); max-width: 680px; }
  .label { max-width: 1208px; margin: 40px auto 10px; padding: 0 var(--section-pad-x); font: 700 13px/1.4 var(--font-body); letter-spacing: .04em; text-transform: uppercase; color: #ffd166; }
  .demo { border-block: 1px dashed rgb(255 255 255 / .15); }
  .stub { height: 90px; background: linear-gradient(90deg, #2a1040, #0d2a3a 40%, #3a1f0c); opacity: .6; }
  .stub--hero { height: auto; padding: 32px var(--section-pad-x); opacity: 1; }
  .stub__card { max-width: 952px; margin-inline: auto; padding: 24px 32px; border-radius: 32px; background: rgb(0 0 0 / .55); display: flex; flex-direction: column; gap: 14px; }
  .stub__name { font-size: var(--fs-display); }
  .stub__line { color: var(--text); font-size: var(--fs-body); }
  .eyebrow { color: var(--nav); text-decoration: none; }
  .eyebrow:hover { color: var(--text); }
  .ic { display: inline-flex; color: var(--nav); }
  .ic:hover { color: var(--text); }
  .hb__right { display: flex; align-items: center; gap: 24px; }
  .hb__right .ic + .ic { margin-left: -8px; }

  /* B */
  .hb { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 16px; height: 56px; padding: 0 var(--section-pad-x); max-width: calc(var(--section-max) + 2 * var(--section-pad-x)); margin-inline: auto; }
  .hb__right { justify-self: end; }
  .hb__tabs { display: flex; padding: 3px; border-radius: 999px; background: rgb(255 255 255 / .06); border: 1px solid rgb(255 255 255 / .1); }
  .hb__tabs a { padding: 6px 14px; border-radius: 999px; font-size: 14px; color: var(--text); text-decoration: none; }
  .hb__tabs a[aria-current] { background: var(--magenta); color: #fff; font-weight: 700; }

  /* C */
  .hc { display: flex; align-items: center; justify-content: space-between; height: 56px; padding: 0 var(--section-pad-x); max-width: calc(var(--section-max) + 2 * var(--section-pad-x)); margin-inline: auto; }
  .hc__crumb { display: flex; align-items: center; gap: 10px; }
  .hc__name { font-family: var(--font-display); font-size: 26px; color: var(--text); text-decoration: none; }
  .hc__slash { color: var(--muted-text); font-size: 22px; }
  .hc__menu { position: relative; }
  .hc__menu summary { list-style: none; cursor: pointer; font-family: var(--font-display); font-size: 26px; color: var(--magenta); }
  .hc__menu summary::-webkit-details-marker { display: none; }
  .hc__menu ul { position: absolute; top: calc(100% + 8px); left: 0; z-index: 30; min-width: 240px; padding: 6px; border-radius: 12px; background: var(--panel); border: 1px solid var(--border); box-shadow: 0 12px 32px rgb(0 0 0 / .5); }
  .hc__menu li a { display: flex; flex-direction: column; padding: 8px 12px; border-radius: 8px; color: var(--text); text-decoration: none; }
  .hc__menu li a:hover { background: rgb(255 255 255 / .06); }
  .hc__menu li a[aria-current] { color: var(--magenta); font-weight: 700; }
  .hc__menu small { font-size: 12px; font-weight: 400; color: var(--muted-text); }

  /* D */
  .hd__top { display: flex; align-items: center; justify-content: space-between; height: 48px; padding: 0 var(--section-pad-x); max-width: calc(var(--section-max) + 2 * var(--section-pad-x)); margin-inline: auto; }
  .hd { border-bottom: 1px solid rgb(255 255 255 / .08); }
  .hd__tabs { display: flex; gap: 28px; padding: 0 var(--section-pad-x); max-width: calc(var(--section-max) + 2 * var(--section-pad-x)); margin-inline: auto; overflow-x: auto; }
  .hd__tabs a { padding: 10px 0 9px; border-bottom: 3px solid transparent; font-size: 15px; color: var(--muted-text); text-decoration: none; white-space: nowrap; }
  .hd__tabs a:hover { color: var(--text); }
  .hd__tabs a[aria-current] { color: var(--text); font-weight: 700; border-color: var(--magenta); }

  /* E */
  .he__chips { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }
  .he__chips span { margin-right: 6px; font: 700 13px/1 var(--font-body); text-transform: uppercase; color: var(--muted-text); }
  .he__chips a { padding: 5px 12px; border-radius: 999px; border: 1px solid rgb(255 255 255 / .2); font-size: 14px; color: var(--text); text-decoration: none; }
  .he__chips a[aria-current] { background: var(--magenta); border-color: var(--magenta); color: #fff; font-weight: 700; }

  @media (max-width: 799.98px) {
    .hb { grid-template-columns: 1fr auto; grid-template-rows: 48px auto; height: auto; padding-bottom: 10px; }
    .hb__tabs { grid-column: 1 / -1; grid-row: 2; justify-self: center; }
    .hb__right, .hd__top .hb__right { gap: 14px; }
    .hc__name, .hc__menu summary { font-size: 20px; }
    .hc .hb__right a.eyebrow { display: none; }
    .stub__card { padding: 20px; }
  }
</style>
