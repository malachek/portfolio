---
/**
 * DEV ONLY: header layouts that put the role (the subdomain) first, since it
 * decides which site and which pages you're on. Round 2; C and E kept for reference.
 * http://localhost:4321/lab/header-options — resize the window for phone layouts.
 */
import Base from '@/layouts/Base.astro';
import Icon from '@/components/icons/Icon.astro';
import { getRoles } from '@/lib/content';

const roles = (await getRoles()).filter((r) => r.data.enabled);
const current = 'gameplay';
const sub = (id: string, host: string) => (id === 'dev' ? '' : host.split('.')[0]);
const cur = roles.find((r) => r.id === current)!;
---
<Base title="Header options (dev)" description="Header layout proposals" noindex>
  <div class="intro wrap">
    <h1 class="display">Header options, round 2</h1>
    <p>Idea: the role is the top level (gameplay. / tools. / design.), and the pages hang under it (gameplay.malachek.com/exo). Each demo shows the Gameplay site on the EXO page. Resize for phones.</p>
  </div>

  <!-- F -->
  <p class="label">F · Address as the logo: <b>gameplay</b>.malachek / exo, where the role is the switcher</p>
  <div class="demo">
    <div class="bar">
      <div class="addr">
        <details class="drop">
          <summary><span class="addr__role">{sub(cur.id, cur.data.host)}</span><span class="caret" aria-hidden="true">▾</span></summary>
          <ul role="list">
            {roles.map((r) => (
              <li><a href="#" aria-current={r.id === current ? 'page' : undefined}>
                <span><b>{sub(r.id, r.data.host) || 'malachek'}</b>{sub(r.id, r.data.host) ? '.malachek.com' : '.com'}</span>
                <small>{r.data.label}{r.id === 'dev' ? ' (everything)' : ''}</small>
              </a></li>
            ))}
          </ul>
        </details>
        <span class="addr__dot">.</span><a class="addr__home" href="#">malachek</a><span class="addr__path"> / exo</span>
      </div>
      <nav class="nav"><a class="eyebrow" href="#">Projects</a><a class="eyebrow" href="#">Resume</a><a class="ic" href="#"><Icon name="github" size={20} label="GitHub" /></a><a class="ic" href="#"><Icon name="linkedin" size={20} label="LinkedIn" /></a></nav>
    </div>
    <div class="stub"></div>
  </div>

  <!-- G -->
  <p class="label">G · Role strip above the header: the subdomains are the first thing on the page</p>
  <div class="demo">
    <nav class="strip" aria-label="Portfolio focus (demo)">
      <div class="strip__in">
        {roles.map((r) => (
          <a href="#" aria-current={r.id === current ? 'page' : undefined}>{sub(r.id, r.data.host) ? <><b>{sub(r.id, r.data.host)}</b>.malachek</> : <b>malachek.com</b>}</a>
        ))}
      </div>
    </nav>
    <div class="bar">
      <a class="name" href="#">Malachy Kennedy</a>
      <nav class="nav"><a class="eyebrow" href="#">Projects</a><a class="eyebrow" href="#">Resume</a><a class="ic" href="#"><Icon name="github" size={20} label="GitHub" /></a><a class="ic" href="#"><Icon name="linkedin" size={20} label="LinkedIn" /></a></nav>
    </div>
    <div class="stub"></div>
  </div>

  <!-- H -->
  <p class="label">H · Role stacked over the name: a small switcher label sits on top of "Malachy Kennedy"</p>
  <div class="demo">
    <div class="bar bar--tall">
      <div class="stack">
        <details class="drop drop--small">
          <summary>{cur.data.label} Engineer<span class="caret" aria-hidden="true">▾</span></summary>
          <ul role="list">{roles.map((r) => <li><a href="#" aria-current={r.id === current ? 'page' : undefined}>{r.data.label}<small>{r.data.host}</small></a></li>)}</ul>
        </details>
        <a class="name name--big" href="#">Malachy Kennedy</a>
      </div>
      <nav class="nav"><a class="eyebrow" href="#">Projects</a><a class="eyebrow" href="#">Resume</a><a class="ic" href="#"><Icon name="github" size={20} label="GitHub" /></a><a class="ic" href="#"><Icon name="linkedin" size={20} label="LinkedIn" /></a></nav>
    </div>
    <div class="stub"></div>
  </div>

  <!-- E2 -->
  <p class="label">E2 · Switcher in the hero, written as addresses (so it reads as "which site am I on")</p>
  <div class="demo">
    <div class="bar"><a class="name" href="#">Malachy Kennedy</a><nav class="nav"><a class="eyebrow" href="#">Projects</a><a class="eyebrow" href="#">Resume</a></nav></div>
    <div class="stub stub--hero">
      <div class="card">
        <div class="urls">
          {roles.map((r) => <a href="#" aria-current={r.id === current ? 'page' : undefined}>{sub(r.id, r.data.host) ? <><b>{sub(r.id, r.data.host)}</b>.malachek.com</> : <><b>malachek</b>.com</>}</a>)}
        </div>
        <p class="display">Malachy Kennedy</p>
        <p class="line">Gameplay engineer with shipped UE5 and Unity titles on Steam…</p>
      </div>
    </div>
  </div>
</Base>

<style>
  .intro { padding-block: 32px 8px; }
  .intro p { margin-top: 8px; color: var(--text); max-width: 720px; }
  .label { max-width: 1208px; margin: 40px auto 10px; padding: 0 var(--section-pad-x); font: 700 13px/1.4 var(--font-body); letter-spacing: .03em; text-transform: uppercase; color: #ffd166; }
  .label b { color: var(--magenta); }
  .demo { border-block: 1px dashed rgb(255 255 255 / .15); }
  .stub { height: 80px; background: linear-gradient(90deg, #2a1040, #0d2a3a 40%, #3a1f0c); opacity: .6; }
  .stub--hero { height: auto; opacity: 1; padding: 28px var(--section-pad-x); }
  .card { max-width: 952px; margin-inline: auto; padding: 24px 32px; border-radius: 32px; background: rgb(0 0 0 / .55); display: flex; flex-direction: column; gap: 12px; }
  .line { color: var(--text); font-size: var(--fs-body); }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 16px; height: 56px; max-width: calc(var(--section-max) + 2 * var(--section-pad-x)); margin-inline: auto; padding: 0 var(--section-pad-x); }
  .bar--tall { height: 72px; }
  .nav { display: flex; align-items: center; gap: 22px; }
  .eyebrow { color: var(--nav); text-decoration: none; }
  .eyebrow:hover, .ic:hover { color: var(--text); }
  .ic { display: inline-flex; color: var(--nav); }
  .name { font-family: var(--font-display); font-size: 24px; color: var(--text); text-decoration: none; }
  .name--big { font-size: 30px; line-height: 1; }
  .caret { margin: 0 2px 0 4px; font-size: .5em; vertical-align: middle; }

  /* dropdown */
  .drop { position: relative; }
  .drop summary { list-style: none; cursor: pointer; }
  .drop summary::-webkit-details-marker { display: none; }
  .drop ul { position: absolute; top: calc(100% + 8px); left: 0; z-index: 30; min-width: 260px; padding: 6px; border-radius: 12px; background: var(--panel); border: 1px solid var(--border); box-shadow: 0 12px 32px rgb(0 0 0 / .5); }
  .drop li a { display: flex; flex-direction: column; gap: 2px; padding: 8px 12px; border-radius: 8px; color: var(--text); text-decoration: none; font-size: 15px; }
  .drop li a:hover { background: rgb(255 255 255 / .06); }
  .drop li a[aria-current] { box-shadow: inset 3px 0 0 var(--magenta); }
  .drop small { font-size: 12px; color: var(--muted-text); }
  .drop--small summary { font: 700 12px/1 var(--font-body); letter-spacing: .08em; text-transform: uppercase; color: var(--magenta); }

  /* F */
  .addr { display: flex; align-items: baseline; font-family: var(--font-display); font-size: 28px; line-height: 1; white-space: nowrap; }
  .addr__role { color: var(--magenta); border-bottom: 2px dashed color-mix(in srgb, var(--magenta) 60%, transparent); }
  .addr .caret { color: var(--magenta); }
  .addr__dot { color: var(--muted-text); }
  .addr__home { color: var(--text); text-decoration: none; }
  .addr__path { margin-left: 8px; color: var(--muted-text); }

  /* G */
  .strip { background: rgb(255 255 255 / .04); border-bottom: 1px solid rgb(255 255 255 / .08); }
  .strip__in { display: flex; gap: 4px; max-width: calc(var(--section-max) + 2 * var(--section-pad-x)); margin-inline: auto; padding: 0 var(--section-pad-x); overflow-x: auto; }
  .strip a { padding: 8px 14px; font-size: 13px; color: var(--muted-text); text-decoration: none; white-space: nowrap; border-bottom: 2px solid transparent; }
  .strip a b { color: var(--text); font-weight: 700; }
  .strip a[aria-current] { border-color: var(--magenta); color: var(--text); background: rgb(213 47 199 / .12); }
  .strip a[aria-current] b { color: var(--magenta); }

  /* H */
  .stack { display: flex; flex-direction: column; gap: 6px; }

  /* E2 */
  .urls { display: flex; flex-wrap: wrap; gap: 6px; }
  .urls a { padding: 5px 12px; border-radius: 8px; border: 1px solid rgb(255 255 255 / .18); font-size: 14px; color: var(--muted-text); text-decoration: none; }
  .urls a b { color: var(--text); }
  .urls a[aria-current] { border-color: var(--magenta); background: rgb(213 47 199 / .18); color: var(--text); }
  .urls a[aria-current] b { color: var(--magenta); }

  @media (max-width: 799.98px) {
    .addr { font-size: 20px; }
    .addr__path { display: none; }
    .nav { gap: 12px; }
    .nav .eyebrow { display: none; }
    .card { padding: 20px; }
  }
</style>
