---
/** Homepage of every non-apex role site (/gameplay/, /tools/, /design/ …). */
import HomePage from '@/layouts/HomePage.astro';
import { APEX_ROLE, getRoles } from '@/lib/content';

export async function getStaticPaths() {
  const roles = await getRoles();
  return roles.filter((r) => r.id !== APEX_ROLE).map((role) => ({ params: { role: role.id }, props: { role } }));
}
const { role } = Astro.props;
---
<HomePage role={role} />
