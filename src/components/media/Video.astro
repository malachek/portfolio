---
/**
 * Silent looping gameplay clip, the GIF replacement (00-ASSET-PIPELINE.md).
 * Behaves like a GIF: autoplays, loops, muted, no player controls (Malachy's call,
 * 2026-09-26, including when the OS asks for reduced motion).
 * - MP4 (H.264) required, WebM optional; files move to R2 (media.malachek.com).
 * - Downloads only as it nears the viewport, and pauses while off screen.
 * - Poster: public/art/posters/<hash>.webp, made from the clip (ffmpeg, 1s in).
 */
interface Props {
  mp4: string;
  webm?: string;
  poster?: string;
  /** Describes what the clip shows, for screen readers. */
  label: string;
  width?: number;
  height?: number;
  class?: string;
}
const { mp4, webm, poster: posterProp, label, width = 1920, height = 1080, class: className } = Astro.props;
// Every clip on R2 has a still of its first second at /art/posters/<hash>.webp, so
// something shows before playback and whenever a browser blocks autoplay
// (Safari in Low Power Mode, data saver).
const r2 = mp4.match(/media\.malachek\.com\/live\/(?:v2\/)?([0-9a-f]+)\.mp4$/);
const poster = posterProp ?? (r2 ? `/art/posters/${r2[1]}.webp` : undefined);
---
<video
  class:list={['clip', className]}
  data-clip
  autoplay
  muted
  loop
  playsinline
  disablepictureinpicture
  disableRemotePlayback
  preload="metadata"
  poster={poster}
  width={width}
  height={height}
  aria-label={label}
>
  {webm && <source src={webm} type="video/webm" />}
  <source src={mp4} type="video/mp4" />
</video>

<script>
  const clips = document.querySelectorAll<HTMLVideoElement>('video[data-clip]');
  const io = new IntersectionObserver(
    (entries) => {
      for (const { target, isIntersecting } of entries) {
        const v = target as HTMLVideoElement;
        if (isIntersecting) {
          v.muted = true; // property, not just the attribute, or some browsers refuse autoplay
          v.play().catch(() => {});
        } else {
          v.pause();
        }
      }
    },
    { rootMargin: '300px 0px', threshold: 0.01 },
  );
  clips.forEach((v) => {
    v.controls = false;
    io.observe(v);
  });
</script>

<style>
  /* Content is fitted, never cropped (logos and content fit; only backgrounds fill). */
  .clip { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: contain; pointer-events: none; }
</style>
