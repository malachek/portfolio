---
/** Skills block (Figma 1:2160): "Skills" in Jersey 10, then one line per group. */
interface Props {
  heading?: string;
  groups: { label: string; items: string[] }[];
}
const { heading = 'Skills', groups } = Astro.props;
---
<section class="skills wrap" aria-labelledby="skills-h">
  <h2 id="skills-h" class="display skills__h">{heading}</h2>
  <ul class="skills__list" role="list">
    {groups.map((g) => (
      <li><strong>{g.label}:</strong> {g.items.join(" · ")}</li>
    ))}
  </ul>
</section>

<style>
  .skills { padding-top: 64px; padding-bottom: 16px; max-width: var(--page-max); }
  .skills__h { line-height: normal; padding-top: 16px; margin-bottom: 8px; }
  .skills__list {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 0 24px 16px;
    font-size: var(--fs-body);
    line-height: var(--lh-prose);
    color: var(--text);
  }
  .skills__list strong { font-weight: 700; }
</style>
