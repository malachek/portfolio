---
/**
 * "Also Built" band: a label, then wide, short capsules with the clip or image
 * on one side and the text on the other. Two across on wide screens, one across
 * below. A project with a page of its own gets a See More button and the whole
 * capsule links to it; one with only an outside link links there.
 * No date on the label: the band spans many projects, so one range misleads.
 */
import type { ImageMetadata } from 'astro';
import Icon from '@/components/icons/Icon.astro';
import type { IconName } from '@/components/icons/icons';
import Media from '@/components/media/Media.astro';
import LinkPill from '@/components/project/LinkPill.astro';

export interface SmallCard {
  title: string;
  blurb: string;
  accent: string;
  href?: string;
  links?: { icon: IconName; href: string; label: string }[];
  media?: { image?: ImageMetadata | string; mp4?: string; poster?: string; alt: string };
}

interface Props {
  label?: string;
  dates?: string;
  cards: SmallCard[];
  more?: { text: string; href: string; label: string };
}

const { label = 'Also Built', cards, more } = Astro.props;
---
<section class="also" aria-labelledby="also-built-h">
  <h2 id="also-built-h" class="also__label">{label}</h2>
  <ul class="also__grid" role="list">
    {cards.map((c) => {
      const main = c.href ?? (c.links?.length === 1 ? c.links[0].href : undefined);
      return (
        <li class:list={['wcard', { 'wcard--link': main }]} style={`--accent:${c.accent}`}>
          <div class="wcard__media">
            {c.media ? <Media {...c.media} sizes="(max-width: 799px) 40vw, 220px" /> : <div class="wcard__blank" />}
          </div>
          <div class="wcard__body">
            <div class="wcard__titlebar">
              <h3 class="wcard__title">{main ? <a class="wcard__main" href={main} rel={c.href ? undefined : 'noopener'}>{c.title}</a> : c.title}</h3>
              {c.links?.map((l) => (
                <a class="wcard__icon" href={l.href} rel="noopener"><Icon name={l.icon} size={22} label={l.label} /></a>
              ))}
            </div>
            <p class="wcard__blurb">{c.blurb}</p>
            {c.href && (
              <div class="wcard__cta"><LinkPill href={c.href} size="sm" color={c.accent}>See More<span class="visually-hidden"> about {c.title}</span></LinkPill></div>
            )}
          </div>
        </li>
      );
    })}
  </ul>
  {more && (
    <p class="also__more">{more.text} <a href={more.href} rel="noopener">{more.label}</a></p>
  )}
</section>

<style>
  .also {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    padding: 28px 0 36px;
    background:
      linear-gradient(rgb(1 2 16 / 0.85), rgb(1 2 16 / 0.85)),
      radial-gradient(ellipse 64% 50% at 50% 50%, #cc69d5 0%, #9f6ce5 50%, #716ef4 100%);
    color: #fff;
  }
  /* Label and grid sit on the same frame as the header and headings. */
  .also__label,
  .also__grid {
    width: 100%;
    max-width: var(--frame-max);
    padding-inline: var(--section-pad-x);
  }
  /* Same type as the group headings ("Burnt Out Games, LLC" style group titles use Jersey 10). */
  .also__label {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--fs-group);
    line-height: 1;
    color: var(--text);
  }
  .also__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .wcard {
    position: relative;
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    align-items: center;
    gap: 18px;
    padding: 12px;
    /* Same capsule as the feature cards: dark and translucent, accent only on the
       hover ring and the button. */
    border-radius: 24px;
    background: var(--scrim-40);
    outline: 2px solid transparent;
    outline-offset: 0;
    transition: outline-color 160ms ease, background-color 160ms ease;
  }
  .wcard__media { position: relative; aspect-ratio: 16 / 10; border-radius: 12px; overflow: clip; background: rgb(0 0 0 / 0.45); }
  .wcard__media :global(.media) { gap: 0; height: 100%; }
  .wcard__media :global(.media__img),
  .wcard__media :global(.clip),
  .wcard__media :global(.media__placeholder) { position: absolute; inset: 0; width: 100%; height: 100%; aspect-ratio: auto; object-fit: contain; }
  .wcard__blank { height: 100%; }
  .wcard__body { display: flex; flex-direction: column; align-items: flex-start; gap: 6px; min-width: 0; padding-right: 6px; }
  .wcard__titlebar { display: flex; align-items: center; gap: 10px; }
  .wcard__title { margin: 0; font-weight: 700; font-size: var(--fs-body); line-height: 1.25; }
  .wcard__title a { text-decoration: none; }
  .wcard__main::after { content: ''; position: absolute; inset: 0; z-index: 1; border-radius: 22px; }
  .wcard__main:focus-visible { outline: none; }
  .wcard__main:focus-visible::after { outline: 3px solid var(--text); outline-offset: 3px; }
  .wcard__icon { position: relative; z-index: 2; display: inline-flex; flex: none; color: #fff; }
  .wcard__cta { position: relative; z-index: 2; margin-top: 4px; }
  .wcard__blurb { margin: 0; font-size: 16px; line-height: 1.45; color: var(--text); }
  .wcard--link:hover { background-color: rgb(0 0 0 / 0.55); outline-color: color-mix(in srgb, var(--accent) 85%, transparent); }
  .wcard--link:hover .wcard__title a { text-decoration: underline; text-underline-offset: 3px; }
  .also__more { padding: 4px var(--section-pad-x) 0; color: var(--text); font-size: var(--fs-body); text-align: center; }

  @media (max-width: 1279.98px) {
    .also__grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 799.98px) {
    .also { padding-block: 24px 28px; }
    .also__grid { gap: 12px; }
    .wcard { grid-template-columns: 132px minmax(0, 1fr); gap: 12px; padding: 10px; border-radius: 20px; }
    .wcard__main::after { border-radius: 18px; }
    .wcard__media { border-radius: 12px; }
    .wcard__title { font-size: 16px; }
    .wcard__blurb { font-size: 14px; }
  }
  @media (max-width: 419.98px) {
    .wcard { grid-template-columns: 1fr; }
    .wcard__media { aspect-ratio: 16 / 9; }
  }
</style>
