---
import LinkPill from '@/components/project/LinkPill.astro';
/**
 * Homepage hero, "T1 chunked" (chosen 2026-09-29).
 * The four game images sit behind (4 across, 2x2 on phones). The name sits on
 * the art like a title logo; the two sentences and the "Role // Place" lines
 * each get their own translucent dark box; the roles box carries a small
 * "Currently" label (the site shows no graduation date). No buttons: the header carries
 * Projects / About / Resume. An "About Me" pill sits beside the name (2026-10-27).
 * The four tiles slowly cycle through key art from every project (`pool`); off under Reduce Motion.
 */
interface Props {
  title: string;
  lines: string[];
  bullets?: string[];
  tiles?: string[];
  background?: string;
  /** The role's About page, shown as a pill beside the name. */
  aboutHref?: string;
  /** Key art from every project, cycled through the tiles. */
  pool?: string[];
}
const { title, lines, bullets = [], tiles = [], background, aboutHref, pool = [] } = Astro.props;
const art = tiles.length ? tiles.slice(0, 4) : background ? [background] : [];
const cycle = art.length === 4 ? [...art, ...pool.filter((p) => !art.includes(p))] : [];
// " B.S." is shown on desktop and tablet only, so the degree line stays on one line on phones.
const roles = bullets.map((b) => {
  const [t, org = ''] = b.split(' // ');
  return { t: t.split(/( B\.S\.)/), org };
});
---
<section class="home-hero">
  <div class:list={['home-hero__bg', { 'home-hero__bg--one': art.length === 1 }]} aria-hidden="true" data-pool={cycle.length > 4 ? JSON.stringify(cycle) : undefined}>
    {art.map((src) => <i style={`background-image:url('${src}')`}><b></b><b></b></i>)}
  </div>
  <div class="home-hero__in">
    <div class="home-hero__titlebar">
      <h1 class="home-hero__name">{title}</h1>
      {aboutHref && <LinkPill href={aboutHref} size="sm">About Me</LinkPill>}
    </div>
    <div class="home-hero__box home-hero__lines">
      {lines.map((l) => <p>{l}</p>)}
    </div>
    {roles.length > 0 && (
      <div class="home-hero__box home-hero__now">
        <p class="home-hero__label" id="hero-now">Currently</p>
        <ul class="home-hero__roles" role="list" aria-labelledby="hero-now">
          {roles.map((r) => (
            <li>
              <span>{r.t.map((part) => (part === ' B.S.' ? <span class="home-hero__wide">{part}</span> : part))}</span>
              {r.org && <span class="sl" aria-hidden="true">{'//'}</span>}
              {r.org && <span>{r.org}</span>}
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>
</section>

<style>
  .home-hero {
    position: relative;
    isolation: isolate;
    overflow: clip;
    display: flex;
    align-items: center;
  }
  .home-hero__bg { position: absolute; inset: 0; z-index: -2; display: grid; grid-template-columns: repeat(4, 1fr); }
  .home-hero__bg--one { grid-template-columns: 1fr; }
  /* The tile shows its first image itself; the two <b> layers above it carry the crossfade. */
  .home-hero__bg i { position: relative; overflow: hidden; background: center / cover no-repeat; }
  .home-hero__bg b { position: absolute; inset: 0; display: block; background: center / cover no-repeat; opacity: 0; transition: opacity 1.6s ease; }
  .home-hero__titlebar { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 20px; margin: 0 0 6px; }
  /* Light shade only: the boxes carry legibility, so the games stay visible. */
  .home-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(90deg, rgb(1 2 16 / 0.5), rgb(1 2 16 / 0.15)),
      linear-gradient(0deg, rgb(1 2 16 / 0.85), transparent 22%);
  }
  .home-hero__in {
    width: 100%;
    max-width: var(--frame-max);
    margin-inline: auto;
    padding: 44px var(--section-pad-x) 48px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
  }
  .home-hero__name {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 88px;
    line-height: 0.85;
    color: var(--text);
    text-shadow: 0 4px 0 rgb(0 0 0 / 0.5), 0 0 24px rgb(0 0 0 / 0.45);
  }
  .home-hero__box {
    background: rgb(1 2 16 / 0.55);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-radius: 24px;
    padding: 20px 24px;
  }
  .home-hero__lines { display: flex; flex-direction: column; gap: 8px; max-width: 720px; }
  .home-hero__lines p { margin: 0; font-size: 20px; line-height: 1.45; color: var(--text-body); }
  /* Roles box: same type as the sentences above (size, line height, white body
     text). "Currently" is a muted label, like the Project Overview labels. */
  .home-hero__lines p,
  .home-hero__now { font-size: 20px; line-height: 1.45; }
  .home-hero__now .home-hero__label { margin: 0 0 4px; font-size: inherit; line-height: inherit; color: var(--muted-text); }
  /* " B.S." shows only when the hero column has room for the full degree line on one
     line (about 380px of text at phone size, plus the box padding). */
  .home-hero__in { container-type: inline-size; }
  @container (max-width: 418px) { .home-hero__wide { display: none; } }
  .home-hero__roles { display: flex; flex-direction: column; gap: 4px; color: var(--text-body); }
  .home-hero__roles li { display: flex; flex-wrap: wrap; column-gap: 8px; }
  .sl { color: var(--magenta); font-weight: 700; }

  @media (max-width: 1279.98px) {
    .home-hero__name { font-size: 72px; }
    .home-hero__lines p,
    .home-hero__now { font-size: 18px; }
  }
  @media (max-width: 799.98px) {
    .home-hero { min-height: 0; }
    .home-hero__bg { grid-template-columns: repeat(2, 1fr); grid-template-rows: repeat(2, 1fr); }
    .home-hero__bg--one { grid-template-columns: 1fr; grid-template-rows: 1fr; }
    .home-hero::before { background: linear-gradient(0deg, rgb(1 2 16 / 0.6), rgb(1 2 16 / 0.3)); }
    .home-hero__in { padding: 40px var(--section-pad-x) 48px; gap: 12px; }
    .home-hero__name { font-size: 54px; }
    .home-hero__box { padding: 16px 18px; border-radius: 24px; }
    .home-hero__lines p,
    .home-hero__now { font-size: 17px; }
  }
  @media (max-width: 359.98px) {
    .home-hero__name { font-size: 46px; }
  }
</style>

<script>
  // Slow crossfade: every few seconds one tile (in turn) fades to the next unseen
  // project image. Skipped under Reduce Motion and when the tab is hidden.
  const bg = document.querySelector<HTMLElement>('.home-hero__bg[data-pool]');
  if (bg && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const pool: string[] = JSON.parse(bg.dataset.pool!);
    const tiles = [...bg.querySelectorAll<HTMLElement>('i')];
    const shown = tiles.map((_, i) => i);
    let next = tiles.length;
    let turn = 0;
    const order = [0, 2, 1, 3];
    setInterval(() => {
      if (document.hidden) return;
      const t = order[turn++ % tiles.length];
      while (shown.includes(next % pool.length)) next++;
      const idx = next++ % pool.length;
      const img = new Image();
      img.onload = () => {
        const layers = tiles[t].querySelectorAll<HTMLElement>('b');
        const k = Number(tiles[t].dataset.k ?? 1) ^ 1; // alternate between the two layers
        layers[k].style.backgroundImage = `url('${pool[idx]}')`;
        layers[k].style.opacity = '1';
        layers[k ^ 1].style.opacity = '0';
        tiles[t].dataset.k = String(k);
        shown[t] = idx;
      };
      img.src = pool[idx];
    }, 4000);
  }
</script>
