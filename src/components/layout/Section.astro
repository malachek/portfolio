---
/**
 * Section (Figma "Project/Section"): a sticky Jersey 10 heading with a magenta
 * rule, then a vertical stack of capsules 24px apart. The heading sticks under
 * the viewport top as on the live site, on a ground-coloured band so content
 * scrolls beneath it cleanly.
 */
interface Props {
  heading?: string;
  /** Anchor id; defaults to a slug of the heading. */
  id?: string;
  /** Heading level. Page title is the only h1; sections default to h2. */
  level?: 2 | 3;
  sticky?: boolean;
  class?: string;
}

const { heading, id, level = 2, sticky = true, class: className } = Astro.props;
const slug =
  id ?? heading?.toLowerCase().replace(/&/g, 'and').replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
const H = `h${level}` as 'h2' | 'h3';
---
<section class:list={['section', 'wrap', className]} id={slug} aria-labelledby={heading ? `${slug}-h` : undefined}>
  {heading && (
    <div class:list={['section__heading', { 'section__heading--sticky': sticky }]}>
      <H class="display" id={`${slug}-h`}>{heading}</H>
      <div class="rule" aria-hidden="true"></div>
    </div>
  )}
  <slot />
</section>

<style>
  .section {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--stack-gap);
    padding-bottom: var(--section-pad-bottom);
  }
  .section > :global(*) {
    width: 100%;
    max-width: var(--content-max);
  }
  .section__heading {
    display: flex;
    flex-direction: column;
    gap: var(--heading-gap);
    padding: var(--heading-pad-top) 0 var(--heading-pad-bottom);
    background: var(--ground);
  }
  .section__heading--sticky {
    position: sticky;
    top: 0;
    z-index: 5;
  }
  .section__heading .rule { height: var(--rule-section); }
</style>
