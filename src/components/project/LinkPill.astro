---
/**
 * Accent link button ("See More", "github.com/malachek/EXO_CodeSamples").
 * Always a real <a>. Background and text colour come from the accent via
 * src/lib/color.ts so every accent passes AA contrast. Same padding at every
 * breakpoint.
 */
import { buttonColors } from '@/lib/color';

interface Props {
  href: string;
  size?: 'code' | 'code-lg' | 'cta';
  /** Accent override, e.g. a project's own colour on home cards. */
  color?: string;
  external?: boolean;
}
const { href, size = 'cta', color, external = /^https?:/.test(href) } = Astro.props;
const c = color ? buttonColors(color) : null;
---
<a
  class:list={['pill', `pill--${size}`]}
  href={href}
  style={c ? `--pill-bg:${c.bg};--pill-ink:${c.ink}` : undefined}
  rel={external ? 'noopener' : undefined}
  target={external ? '_blank' : undefined}
><span class="pill__label"><slot /></span>{external && <span class="visually-hidden"> (opens in a new tab)</span>}</a>

<style>
  /* Figma's flat accent pill, kept plain: regular weight, no icon, no lift.
     Only the colours (contrast-safe, src/lib/color.ts) and the padding
     (same at every size) differ from the original. */
  .pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 6px 16px;
    border-radius: var(--radius-pill);
    background: var(--pill-bg, var(--accent-btn, var(--accent)));
    color: var(--pill-ink, var(--accent-ink, #fff));
    line-height: var(--lh-compact);
    text-decoration: none;
    transition: filter 120ms ease;
  }
  .pill:hover { filter: brightness(1.12); }
  .pill--cta { font-size: var(--fs-body); white-space: nowrap; }
  .pill--code { font-size: var(--fs-code-link); overflow-wrap: break-word; text-align: left; }
  .pill--code-lg { padding: 8px 16px; font-size: var(--fs-body); line-height: var(--lh-prose); font-weight: 700; font-style: italic; overflow-wrap: anywhere; }
</style>
