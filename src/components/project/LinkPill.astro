---
/**
 * Accent link button ("See More", "github.com/malachek/EXO_CodeSamples").
 * Always a real <a>. Background and text colour come from the accent via
 * src/lib/color.ts so every accent passes AA contrast. Same padding at every
 * breakpoint; a trailing arrow (→ internal, ↗ external) nudges on hover.
 */
import { buttonColors } from '@/lib/color';

interface Props {
  href: string;
  size?: 'code' | 'code-lg' | 'cta';
  /** Accent override, e.g. a project's own colour on home cards. */
  color?: string;
  external?: boolean;
}
const { href, size = 'cta', color, external = /^https?:/.test(href) } = Astro.props;
const c = color ? buttonColors(color) : null;
---
<a
  class:list={['pill', `pill--${size}`]}
  href={href}
  style={c ? `--pill-bg:${c.bg};--pill-ink:${c.ink}` : undefined}
  rel={external ? 'noopener' : undefined}
  target={external ? '_blank' : undefined}
><span class="pill__label"><slot /></span><svg class="pill__arrow" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">{external
  ? <path d="M5 11 11 5M6 5h5v5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
  : <path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />}</svg>{external && <span class="visually-hidden"> (opens in a new tab)</span>}</a>

<style>
  .pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 40px;
    padding: 8px 16px;
    border-radius: var(--radius-pill);
    background: var(--pill-bg, var(--accent-btn, var(--accent)));
    color: var(--pill-ink, var(--accent-ink, #fff));
    font-weight: 700;
    line-height: 1.2;
    text-decoration: none;
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.18), 0 2px 8px rgb(0 0 0 / 0.35);
    transition: transform 0.15s ease, filter 0.15s ease, box-shadow 0.15s ease;
  }
  .pill__label { min-width: 0; }
  .pill__arrow { flex: none; transition: transform 0.15s ease; }
  .pill:hover {
    filter: brightness(1.1);
    transform: translateY(-1px);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.22), 0 6px 14px rgb(0 0 0 / 0.4);
  }
  .pill:hover .pill__arrow { transform: translateX(2px); }
  .pill:active { transform: translateY(0); filter: brightness(0.96); }

  .pill--cta { font-size: 18px; white-space: nowrap; }
  .pill--code { font-size: var(--fs-code-link); overflow-wrap: break-word; text-align: left; }
  .pill--code-lg { font-size: var(--fs-body); padding: 10px 18px; overflow-wrap: anywhere; text-align: left; }

  @media (max-width: 799.98px) {
    .pill { min-height: 44px; padding: 8px 14px; }
    .pill--cta { font-size: 16px; }
  }
</style>
