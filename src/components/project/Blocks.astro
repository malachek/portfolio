---
/**
 * Renders a section's blocks with the Figma components:
 *   subsection -> SubsectionHeading
 *   text       -> Capsule + prose (optional inline title as <h4>)
 *   bullets    -> Capsule + compact bullet list
 *   media      -> Capsule + MediaRow of Media items
 *   link       -> centred magenta pill
 */
import type { CollectionEntry } from 'astro:content';
import Capsule from '@/components/layout/Capsule.astro';
import SubsectionHeading from '@/components/layout/SubsectionHeading.astro';
import MediaRow from '@/components/media/MediaRow.astro';
import Media from '@/components/media/Media.astro';
import LinkPill from '@/components/project/LinkPill.astro';
import { renderMarkdown, renderInline } from '@/lib/markdown';

type Block = CollectionEntry<'projects'>['data']['sections'][number]['blocks'][number];
interface Props { blocks: Block[] }
const { blocks } = Astro.props;

const mediaSizes = { 1: '(max-width: 799px) 100vw, 888px', 2: '(max-width: 799px) 100vw, 428px', 3: '(max-width: 799px) 100vw, (max-width: 1279px) 332px, 274px' } as const;
---
{blocks.map((b, i) => {
  // A text title sits under a subsection heading (h3) when one came before it
  // in this section; otherwise directly under the section heading (h2).
  const TitleTag = blocks.slice(0, i).some((x) => x.type === 'subsection') ? 'h4' : 'h3';
  switch (b.type) {
    case 'subsection':
      return <SubsectionHeading id={b.id}>{b.title}</SubsectionHeading>;
    case 'text':
      return (
        <Capsule>
          <div class:list={['text-block', { 'text-block--embed': b.embed }]}>
            <div class:list={['prose', { 'prose--wide': b.wide }]} data-block={b.id}>
              {b.title && <TitleTag class="capsule-title">{b.title}</TitleTag>}
              {(() => {
                const paras = b.md.split(/\n\s*\n/);
                if (!b.collapse || paras.length < 2) return <Fragment set:html={renderMarkdown(b.md)} />;
                return (
                  <>
                    <Fragment set:html={renderMarkdown(paras[0])} />
                    <details class="more">
                      <summary><span class="more__open">Read more</span><span class="more__close">Show less</span></summary>
                      <div class="more__body prose"><Fragment set:html={renderMarkdown(paras.slice(1).join('\n\n'))} /></div>
                    </details>
                  </>
                );
              })()}
            </div>
            {b.embed && (
              <iframe class="embed-page" src={b.embed.src} title={b.embed.title} width={b.embed.width} height={b.embed.height} loading="lazy"></iframe>
            )}
          </div>
        </Capsule>
      );
    case 'bullets':
      return (
        <Capsule>
          {(() => {
            const shown = b.peek && b.peek < b.items.length ? b.items.slice(0, b.peek) : b.items;
            const rest = b.items.slice(shown.length);
            return (
              <div data-block={b.id}>
                <ul class="bullets">
                  {shown.map((i) => <li set:html={renderInline(i)} />)}
                </ul>
                {rest.length > 0 && (
                  <details class="more">
                    <summary><span class="more__open">Show {rest.length} more</span><span class="more__close">Show less</span></summary>
                    <ul class="bullets more__body">
                      {rest.map((i) => <li set:html={renderInline(i)} />)}
                    </ul>
                  </details>
                )}
              </div>
            );
          })()}
        </Capsule>
      );
    case 'media':
      return (
        <Capsule media>
          {b.md && <div class="prose media-lead"><Fragment set:html={renderMarkdown(b.md)} /></div>}
          <MediaRow cols={b.cols}>
            {b.items.map((m) =>
              m.kind === 'video'
                ? <Media mp4={m.src} poster={m.poster} alt={m.alt} caption={m.caption} />
                : <Media image={m.src} alt={m.alt} caption={m.caption} sizes={mediaSizes[b.cols]} zoom />,
            )}
          </MediaRow>
        </Capsule>
      );
    case 'embed':
      return (
        <Capsule media>
          <figure class="embed-fig">
            <iframe class="embed" src={b.src} title={b.title} loading="lazy" allow="encrypted-media; picture-in-picture; fullscreen" allowfullscreen></iframe>
            {b.caption && <figcaption class="embed-caption">{b.caption}</figcaption>}
          </figure>
        </Capsule>
      );
    case 'link':
      return (
        <div class="block-link">
          <LinkPill href={b.href} size="code-lg">{b.label}</LinkPill>
        </div>
      );
  }
})}

<style>
  .capsule-title { font: inherit; }
  .prose--wide { max-width: none; }
  .embed-fig { display: flex; flex-direction: column; gap: var(--caption-gap); }
  .embed { width: 100%; aspect-ratio: 3 / 2; border: 0; }
  .embed-caption { text-align: center; color: var(--text-body); line-height: var(--lh-compact); }
  .text-block--embed { display: flex; gap: 32px; align-items: flex-start; }
  .text-block--embed .prose { flex: 1 1 0; }
  .embed-page { flex: 0 0 auto; width: min(392px, 100%); border: 0; background: #fff; }
  @media (max-width: 799.98px) {
    .text-block--embed { flex-direction: column; }
  }
  .block-link { display: flex; justify-content: center; }
  /* Text that belongs to a diagram or clip sits in its capsule, above it. */
  .media-lead { max-width: var(--text-w); margin-bottom: var(--stack-gap); }

  /* Read more / Show N more: plain underlined text toggle, no arrows or buttons. */
  .more { margin-top: var(--list-gap); }
  .more > summary {
    display: inline-block;
    cursor: pointer;
    list-style: none;
    color: var(--muted-text);
    text-decoration: underline;
    text-underline-offset: 4px;
    font-size: var(--fs-body);
  }
  .more > summary::-webkit-details-marker { display: none; }
  .more > summary:hover { color: var(--text); }
  .more > summary:focus-visible { outline: 2px solid var(--focus); outline-offset: 3px; border-radius: 4px; }
  .more .more__close { display: none; }
  .more[open] .more__open { display: none; }
  .more[open] .more__close { display: inline; }
  .more[open] > summary { margin-top: var(--list-gap); order: 2; }
  .more[open] { display: flex; flex-direction: column; }
  .more__body { margin-top: var(--list-gap); }
  .bullets.more__body { margin-top: 0; } /* .more already carries one list-gap, so opened items keep the normal bullet spacing */
</style>
