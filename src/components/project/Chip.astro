---
/** Tech tag (Figma "Tag"): 60% magenta fill, 4px radius, white text. */
interface Props { color?: string }
const { color = 'color-mix(in srgb, var(--accent) 60%, transparent)' } = Astro.props;
---
<li class="chip" style={`--chip-bg:${color}`}><slot /></li>

<style>
  .chip {
    display: inline-flex;
    align-items: center;
    padding: 3px 6px;
    border-radius: var(--radius-chip);
    background: var(--chip-bg);
    color: #fff;
    font-size: var(--fs-chip);
    line-height: var(--lh-compact);
    white-space: nowrap;
    list-style: none;
  }
</style>
