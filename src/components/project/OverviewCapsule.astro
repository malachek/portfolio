---
/**
 * "Project Overview" capsule (Figma "Container Project", 1:1552).
 * Left: title, rule, a label | value table. Right: the Steam store widget (when
 * the game has a store page) and the code-samples pill. Mobile stacks them.
 * Rendered as a <dl> so each label is programmatically tied to its value.
 */
import LinkPill from '@/components/project/LinkPill.astro';

interface Props {
  rows: { label: string; value: string }[];
  steamAppIds?: number[];
  code?: { href: string; label: string };
  heading?: string;
}
const { rows, steamAppIds = [], code, heading = 'Project Overview' } = Astro.props;
---
<div class="overview wrap">
  <div class="overview__panel">
    <div class="overview__left">
      <h2 class="display overview__title">{heading}</h2>
      <div class="rule" aria-hidden="true"></div>
      <dl class="overview__table">
        {rows.map((r) => (
          <div class="overview__row">
            <dt>{r.label}</dt>
            <dd>{r.value}</dd>
          </div>
        ))}
      </dl>
    </div>
    {(steamAppIds.length > 0 || code) && (
      <div class="overview__right">
        {steamAppIds.map((id) => (
          <div class="overview__storewrap"><iframe
            class="overview__store"
            src={`https://store.steampowered.com/widget/${id}/`}
            title="Steam store page"
            loading="lazy"
            width="646"
            height="190"
          ></iframe></div>
        ))}
        {code && <LinkPill href={code.href} size="code">{code.label.split('/').map((part, i) => i === 0 ? part : <Fragment>/<wbr />{part}</Fragment>)}</LinkPill>}
      </div>
    )}
  </div>
</div>

<style>
  /* Spec-sheet layout: heading, rule and table share one left edge; the
     label | value divider sits in the accent colour with even space either
     side; rows breathe equally; the panel pads evenly on all sides. */
  .overview { display: flex; justify-content: center; padding-bottom: 36px; }
  .overview__panel {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 40px;
    width: 100%;
    max-width: var(--content-max);
    padding: 28px var(--capsule-pad-x);
    border-radius: var(--capsule-radius);
    background: var(--panel);
  }
  .overview__left { display: flex; flex-direction: column; gap: 14px; flex: 1 1 auto; min-width: 0; }
  .overview__title { text-align: left; }
  .overview__left .rule { height: var(--rule-section); }
  .overview__table {
    display: grid;
    grid-template-columns: max-content 1fr;
    margin: 4px 0 0;
    font-size: var(--fs-body);
    line-height: 1.3;
  }
  .overview__row { display: contents; }
  .overview__row dt,
  .overview__row dd { margin: 0; padding-block: 5px; }
  .overview__row dt { padding-right: 16px; color: var(--muted-text); } /* --nav is 4.42:1 on the panel */
  .overview__row dd { padding-left: 16px; color: var(--text); border-left: 2px solid color-mix(in srgb, var(--accent) 70%, transparent); }
  .overview__row:first-child > * { padding-top: 2px; }
  .overview__row:last-child > * { padding-bottom: 2px; }
  .overview__right {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    flex: 0 0 392px;
    min-width: 0;
    padding-top: 4px;
  }
  /* Steam's widget has a fixed layout that clips when narrow. Render it at its
     natural width and scale it to fit the column (script below sets --s). */
  .overview__storewrap { width: 100%; height: calc(180px * var(--s, 1)); overflow: hidden; border-radius: 4px; }
  .overview__store { display: block; width: 420px; height: 180px; border: 0; border-radius: 4px; background: #1b2838; transform: scale(var(--s, 1)); transform-origin: 0 0; }

  @media (max-width: 1279.98px) {
    .overview__panel { gap: 28px; padding: 24px; }
    .overview__right { flex-basis: 340px; }
  }
  /* Tablet: the table needs the width, so the store box moves below it. */
  @media (max-width: 1279.98px) {
    .overview__panel { flex-direction: column; align-items: stretch; gap: 22px; }
    .overview__right { flex-basis: auto; width: 100%; max-width: 440px; align-self: center; padding-top: 0; }
  }
  @media (max-width: 799.98px) {
    .overview__panel { flex-direction: column; align-items: stretch; gap: 20px; padding: 22px 18px; }
    .overview__left { gap: 12px; }
    .overview__row dt { padding-right: 12px; }
    .overview__row dd { padding-left: 12px; }
    .overview__right { flex-basis: auto; width: 100%; padding-top: 0; }
  }
</style>

<script>
  const fit = () => {
    for (const w of document.querySelectorAll<HTMLElement>('.overview__storewrap')) {
      const s = Math.min(1, w.clientWidth / 420);
      w.style.setProperty('--s', String(s));
    }
  };
  fit();
  addEventListener('resize', fit);
</script>
