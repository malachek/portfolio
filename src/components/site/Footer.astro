---
/**
 * Site footer. Replaces the file's repeated-header footer (Figma 1:4119), which
 * read as a second header. Left: name and the availability line (plain text,
 * 00-SITE-WIDE.md §1). Right: every contact route as its own real link, then the
 * page links. A hairline separates it from the page.
 */
import Icon from '@/components/icons/Icon.astro';

interface Props {
  name: string;
  email: string;
  github: string;
  linkedin: string;
  availability: string;
  nav: { label: string; href: string }[];
  homeHref?: string;
}

const { name, email, github, linkedin, availability, nav, homeHref = '/' } = Astro.props;
const bare = (u: string) => u.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__who">
      <a class="site-footer__name" href={homeHref}>{name}</a>
      <p class="site-footer__avail">{availability}</p>
      <ul class="site-footer__quick" role="list">
        {nav.filter((n) => n.label !== 'Resume').reverse().map((n) => <li><a class="eyebrow" href={n.href}>{n.label}</a></li>)}
      </ul>
    </div>
    <ul class="site-footer__contact" role="list" aria-label="Contact">
      <li><a href={`mailto:${email}`}><Icon name="mail" size={18} />{email}</a></li>
      <li><a href={github} rel="me"><Icon name="github" size={18} />{bare(github)}</a></li>
      <li><a href={linkedin} rel="me"><Icon name="linkedin" size={18} />{bare(linkedin)}</a></li>
    </ul>
  </div>
  <div class="site-footer__base">
    <p>© {year} {name}</p>
    <nav aria-label="Footer">
      <ul role="list">
        {nav.map((item) => <li><a class="eyebrow" href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 48px;
    border-top: 1px solid rgb(255 255 255 / 0.08);
    background: var(--ground);
    color: var(--nav);
  }
  .site-footer__inner,
  .site-footer__base {
    display: flex;
    justify-content: space-between;
    gap: 32px;
    max-width: var(--frame-max);
    margin-inline: auto;
    padding-inline: var(--section-pad-x);
  }
  .site-footer__inner { padding-block: 40px 32px; align-items: flex-start; }
  .site-footer__quick { display: flex; gap: 20px; margin: 4px 0 0; padding: 0; list-style: none; }
  .site-footer__quick a { color: var(--text); text-decoration: none; }
  .site-footer__quick a:hover { color: #fff; text-decoration: underline; text-underline-offset: 4px; }
  .site-footer__who { display: flex; flex-direction: column; gap: 12px; max-width: 460px; }
  .site-footer__name {
    font-family: var(--font-display);
    font-size: 32px;
    line-height: 1;
    color: var(--text);
    text-decoration: none;
  }
  .site-footer__avail { font-size: 16px; line-height: 1.5; color: var(--muted-text); }
  .site-footer__contact { display: flex; flex-direction: column; gap: 12px; }
  .site-footer__contact a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 16px;
    color: var(--text);
    text-decoration: none;
  }
  .site-footer__contact a :global(svg) { color: var(--nav); flex: none; }
  .site-footer__contact a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .site-footer__base {
    align-items: center;
    padding-block: 16px 24px;
    /* Hairline inset to the content width, not the padding. */
    background: linear-gradient(rgb(255 255 255 / 0.08), rgb(255 255 255 / 0.08)) center top / calc(100% - 2 * var(--section-pad-x)) 1px no-repeat;
    font-size: 14px;
  }
  .site-footer__base ul { display: flex; gap: 24px; }
  .site-footer__base a { color: var(--nav); text-decoration: none; }
  .site-footer__base a:hover { color: var(--text); }

  @media (max-width: 1279.98px) {
    .site-footer__inner, .site-footer__base { max-width: var(--frame-max); }
  }
  @media (max-width: 799.98px) {
    .site-footer__inner { flex-direction: column; gap: 24px; padding-block: 32px 24px; }
    .site-footer__name { font-size: 28px; }
    .site-footer__contact a { font-size: 15px; }
  }
</style>
