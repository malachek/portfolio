---
/**
 * Site header. Left: the name. Centre: the role's job title as a dropdown that
 * switches role site (on phones it sits above the name).
 * The dropdown switches between the role sites (links carry data-lens so the
 * production Worker points them at each role's own host). Right: Projects,
 * Resume, GitHub, LinkedIn. Sticky, with a hairline under it.
 */
import Icon from '@/components/icons/Icon.astro';
import { getRoles, getRole, roleBase, href, rolePaths } from '@/lib/content';

interface Props {
  name: string;
  github: string;
  linkedin: string;
  nav: { label: string; href: string }[];
  homeHref?: string;
  roleId: string;
}

const { name, github, linkedin, nav, homeHref = '/', roleId } = Astro.props;
const roles = await getRoles();
const current = await getRole(roleId);

// Switching role keeps you on the same page when the other role has it (the same
// project, About, Resume); otherwise it lands on that role's homepage.
const base = roleBase(roleId);
const here = (Astro.url.pathname.startsWith(`${base}/`) || base === '' ? Astro.url.pathname.slice(base.length) : '/').replace(/\/+$/, '') || '/';
const targets = await Promise.all(
  roles.map(async (r) => {
    const keep = (await rolePaths(r.id)).has(here) ? here : '/';
    return { id: r.id, path: keep, href: href(r.id, keep) };
  }),
);
const target = (id: string) => targets.find((t) => t.id === id)!;
---
<header class="site-header">
  <div class="site-header__inner">
    {roles.length > 1 ? (
        <details class="role" data-role-menu>
          <summary class="role__label">
            <span class="visually-hidden">Portfolio focus: </span>{current.data.jobTitle}
            <svg class="role__caret" viewBox="0 0 12 12" width="10" height="10" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </summary>
          <div class="role__menu">
            <p class="role__hint">Same work, a different focus</p>
            <ul role="list">
              {roles.map((r) => (
                <li>
                  <a
                    href={target(r.id).href}
                    data-lens={r.id}
                    data-lens-path={target(r.id).path}
                    aria-current={r.id === roleId ? 'page' : undefined}
                  >
                    <span class="role__title">{r.data.jobTitle}{!r.data.enabled && ' (draft)'}</span>
                    <small class="role__host">{r.data.host}{target(r.id).path !== '/' && target(r.id).path}</small>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </details>
      ) : (
        <p class="role role__label">{current.data.jobTitle}</p>
      )}
    <a class="eyebrow brand__name" href={homeHref}>{name}</a>
    <nav class="site-header__nav" aria-label="Primary">
      <ul role="list">
        {nav.map((item) => (
          <li data-nav={item.label.toLowerCase()}><a class="eyebrow site-header__link" href={item.href}>{item.label}</a></li>
        ))}
        <li class="site-header__icons">
          <a class="site-header__icon" href={github} rel="me"><Icon name="github" size={20} label="GitHub" /></a>
          <a class="site-header__icon" href={linkedin} rel="me"><Icon name="linkedin" size={20} label="LinkedIn" /></a>
        </li>
      </ul>
    </nav>
    <details class="navmenu" data-menu>
      <summary class="navmenu__btn">
        <span class="visually-hidden">Menu</span>
        <svg class="navmenu__open" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
        <svg class="navmenu__close" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
      </summary>
      <div class="navmenu__panel">
        <ul role="list">
          {nav.map((item) => <li><a class="eyebrow" href={item.href}>{item.label}</a></li>)}
          <li class="navmenu__social">
            <a href={github} rel="me"><Icon name="github" size={20} /> GitHub</a>
            <a href={linkedin} rel="me"><Icon name="linkedin" size={20} /> LinkedIn</a>
          </li>
        </ul>
      </div>
    </details>
  </div>
</header>

<script>
  // Close the role menu and the hamburger menu on outside click or Escape.
  for (const menu of document.querySelectorAll<HTMLDetailsElement>('[data-role-menu], [data-menu]')) {
    document.addEventListener('click', (e) => {
      if (menu.open && !menu.contains(e.target as Node)) menu.open = false;
    });
    menu.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.open) {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    height: var(--header-h);
    background: color-mix(in srgb, var(--ground) 92%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid rgb(255 255 255 / 0.08);
  }
  .site-header__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    grid-template-areas: 'name role nav';
    align-items: center;
    column-gap: 16px;
    height: 100%;
    max-width: var(--frame-max);
    margin-inline: auto;
    padding-inline: var(--section-pad-x);
  }
  .site-header__nav, .navmenu { grid-area: nav; justify-self: end; }

  /* ---- Name: same type family as the nav, a step larger, in text colour.
     (The pixel display face is kept for page and section headings.) ---- */
  .brand__name {
    grid-area: name;
    justify-self: start;
    font-size: 17px;
    letter-spacing: 0.04em;
    color: var(--text);
    text-decoration: none;
    white-space: nowrap;
    transition: color 120ms ease;
  }
  .brand__name:hover { color: #fff; }

  /* ---- Role switcher: a centred pill ---- */
  .role { grid-area: role; justify-self: center; position: relative; }
  .role__label {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    font: 700 12px/1 var(--font-body);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--magenta);
    white-space: nowrap;
  }
  summary.role__label {
    list-style: none;
    cursor: pointer;
    padding: 9px 14px;
    border: 1px solid color-mix(in srgb, var(--magenta) 45%, transparent);
    border-radius: 999px;
    transition: background-color 120ms ease, color 120ms ease, border-color 120ms ease;
  }
  summary.role__label::-webkit-details-marker { display: none; }
  summary.role__label:hover { background: rgb(255 255 255 / 0.05); color: #f06ae4; border-color: var(--magenta); }
  .role[open] summary.role__label { background: rgb(255 255 255 / 0.06); border-color: var(--magenta); }
  .role__caret { transition: transform 150ms ease; }
  .role[open] .role__caret { transform: rotate(180deg); }

  .role__menu {
    position: absolute;
    top: calc(100% + 12px);
    left: 50%;
    transform: translateX(-50%);
    z-index: 30;
    min-width: 280px;
    padding: 8px;
    border-radius: 14px;
    background: var(--panel);
    border: 1px solid rgb(255 255 255 / 0.1);
    box-shadow: 0 16px 40px rgb(0 0 0 / 0.55);
  }
  .role__hint {
    margin: 4px 10px 8px;
    font: 700 11px/1.2 var(--font-body);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted-text);
  }
  .role__menu a {
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding: 10px 12px;
    border-radius: 8px;
    color: var(--text);
    text-decoration: none;
  }
  .role__menu a:hover { background: rgb(255 255 255 / 0.06); }
  .role__menu a[aria-current] { background: color-mix(in srgb, var(--magenta) 16%, transparent); box-shadow: inset 3px 0 0 var(--magenta); }
  .role__title { font-weight: 700; font-size: 16px; }
  .role__host { font-size: 13px; color: var(--muted-text); }

  /* ---- Nav ---- */
  .site-header__nav ul { display: flex; align-items: center; gap: 32px; }
  .site-header__link {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    color: var(--nav);
    text-decoration: none;
    transition: color 120ms ease;
  }
  .site-header__link:hover { color: var(--text); }
  .site-header__icons { display: flex; align-items: center; gap: 16px; }
  .site-header__icon {
    display: inline-flex;
    padding: 6px;
    margin: -6px;
    color: var(--nav);
    transition: color 120ms ease;
  }
  .site-header__icon:hover,
  .site-header__icon:focus-visible { color: var(--text); }

  @media (max-width: 1279.98px) {
    .site-header__inner { max-width: 800px; }
    .site-header__nav ul { gap: 24px; }
  }
  @media (max-width: 799.98px) {
    .role__label { font-size: 11px; }
    .site-header__nav ul { gap: 16px; }
    .site-header__icons { gap: 14px; }
  }
  /* ---- Hamburger: when the links no longer fit beside the name ---- */
  .navmenu { display: none; position: relative; }
  .navmenu__btn {
    list-style: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    margin-right: -10px;
    border-radius: 10px;
    color: var(--text);
    cursor: pointer;
  }
  .navmenu__btn::-webkit-details-marker { display: none; }
  .navmenu__btn:hover { background: rgb(255 255 255 / 0.06); }
  .navmenu__close { display: none; }
  .navmenu[open] .navmenu__open { display: none; }
  .navmenu[open] .navmenu__close { display: block; }
  .navmenu__panel {
    position: absolute;
    top: calc(100% + 10px);
    right: -10px;
    z-index: 30;
    min-width: 220px;
    padding: 8px;
    border-radius: 14px;
    background: var(--panel);
    border: 1px solid rgb(255 255 255 / 0.1);
    box-shadow: 0 16px 40px rgb(0 0 0 / 0.55);
  }
  .navmenu__panel a {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px;
    border-radius: 8px;
    color: var(--text);
    text-decoration: none;
  }
  .navmenu__panel a:hover { background: rgb(255 255 255 / 0.06); }
  .navmenu__social { display: flex; flex-direction: column; margin-top: 6px; padding-top: 6px; border-top: 1px solid rgb(255 255 255 / 0.08); }
  .navmenu__social a { font-size: 15px; color: var(--nav); }
  .navmenu__panel a.eyebrow { color: var(--text); }

  /* The centred title needs equal side columns; below ~960px the links fold
     into the hamburger so the title can stay centred. */
  @media (max-width: 959.98px) {
    .site-header__nav { display: none; }
    .navmenu { display: block; }
  }
  @media (max-width: 639.98px) {
    /* Phones: the title sits above the name (plain label, no pill); menu on the right. */
    .site-header__inner {
      grid-template-columns: 1fr auto;
      grid-template-areas: 'role nav' 'name nav';
      row-gap: 5px;
      align-content: center;
    }
    .role { justify-self: start; }
    summary.role__label { padding: 4px 6px; margin: -4px -6px; border: 0; border-radius: 6px; }
    .role__label { font-size: 11px; }
    .role__menu { left: -6px; transform: none; min-width: min(280px, calc(100vw - 32px)); }
    .brand__name { font-size: 16px; }
  }
  @media (max-width: 399.98px) {
    .role__label { letter-spacing: 0.03em; }
  }
</style>
