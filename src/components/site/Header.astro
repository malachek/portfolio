---
/**
 * Site header (Figma "Universal / Header", 1:4051).
 * Desktop/tablet: name left, nav right. Mobile: name centred over one row of
 * [GitHub] Projects Resume [LinkedIn], matching the file's mobile variant.
 */
import Icon from '@/components/icons/Icon.astro';

interface Props {
  name: string;
  github: string;
  linkedin: string;
  nav: { label: string; href: string }[];
  homeHref?: string;
  /** The footer repeats this row; it must not be a second banner landmark. */
  as?: 'header' | 'div';
  navLabel?: string;
}

const { name, github, linkedin, nav, homeHref = '/', as: Tag = 'header', navLabel = 'Primary' } = Astro.props;
---
<Tag class="site-header">
  <div class="site-header__inner">
    <a class="site-header__name eyebrow" href={homeHref}>{name}</a>
    <nav class="site-header__nav" aria-label={navLabel}>
      <a class="site-header__icon site-header__icon--github" href={github} rel="me">
        <Icon name="github" size={24} label="GitHub" />
      </a>
      {nav.map((item) => (
        <a class="eyebrow site-header__link" href={item.href}>{item.label}</a>
      ))}
      <a class="site-header__icon" href={linkedin} rel="me">
        <Icon name="linkedin" size={24} label="LinkedIn" />
      </a>
    </nav>
  </div>
  <slot />
</Tag>

<style>
  .site-header {
    background: var(--ground);
    padding-bottom: 4px;
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: var(--section-max);
    margin-inline: auto;
    padding: 8px var(--section-pad-x) 0;
    min-height: calc(var(--header-h) - 4px);
  }
  .site-header__name { text-decoration: none; }
  .site-header__nav {
    display: flex;
    align-items: center;
    gap: 32px;
  }
  /* Desktop and tablet order: Projects, Resume, GitHub, LinkedIn */
  .site-header__icon--github { order: 1; }
  .site-header__icon:last-child { order: 2; }
  .site-header__link {
    text-decoration: none;
  }
  .site-header__link:hover,
  .site-header__name:hover { color: var(--text); }
  .site-header__icon {
    display: inline-flex;
    color: #fff;
    opacity: var(--icon-opacity, 0.34);
    transition: opacity 120ms ease;
  }
  .site-header__icon:hover,
  .site-header__icon:focus-visible { opacity: 1; }

  @media (max-width: 1279.98px) {
    .site-header__inner { max-width: 800px; }
  }

  @media (max-width: 799.98px) {
    .site-header { padding-bottom: 8px; }
    .site-header__inner {
      flex-direction: column;
      gap: 1px;
      padding: 6px 24px 0;
    }
    .site-header__name { text-align: center; }
    .site-header__nav { align-items: flex-end; justify-content: center; width: 100%; }
    /* Mobile order from the file: GitHub, Projects, Resume, LinkedIn */
    .site-header__icon--github { order: 0; }
    .site-header__icon :global(svg) { width: 20px; height: 20px; }
  }
</style>
