---
/**
 * About page, one per role site (same content everywhere; only the header's
 * role and the links differ). Content: the `about` block in src/content/site.yaml.
 * Topic sections use the project-page blocks (Blocks.astro), so type, captions and
 * padding match the rest of the site.
 */
import { getEntry, getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Section from '@/components/layout/Section.astro';
import Capsule from '@/components/layout/Capsule.astro';
import Blocks from '@/components/project/Blocks.astro';
import MediaRow from '@/components/media/MediaRow.astro';
import Media from '@/components/media/Media.astro';
import { absUrl, getRoles, href, resolveProject, type Role } from '@/lib/content';
import { renderMarkdown } from '@/lib/markdown';

interface Props { role: Role }
const { role } = Astro.props;
const site = (await getEntry('site', 'site'))!.data;
const a = site.about;
const PORT_GROUPS: { label: string; items: [string, string][]; note?: string }[] = [
  { label: 'General', items: [['dev', 'main']], note: '(across all roles)' },
  { label: 'Games', items: [['gameplay', 'gameplay engineering'], ['tools', 'tools engineering'], ['design', 'game design']] },
  { label: 'Software', items: [['software', 'software engineering'], ['production', 'technical production']] },
];
const portfolios = (await getRoles()).map((r) => ({ id: r.id, sub: r.data.host === 'malachek.com' ? 'main' : r.data.host.split('.')[0], href: href(r.id, '/'), current: r.id === role.id }));
---
<Base title={`About | ${site.name}`} description={a.description} canonical={absUrl(role, '/about')} roleId={role.id}>
  <Section heading={a.heading} id="about" level={2}>
    <h1 class="visually-hidden">About {site.name}</h1>
    <Capsule class="about-intro">
      <button type="button" class="about-intro__zoom" data-zoom aria-label={`View larger: ${a.portrait.alt}`}>
        <img class="about-intro__photo" src={a.portrait.src} alt={a.portrait.alt} width="651" height="700" />
      </button>
      <div class="about-intro__text">
        {a.intro.map((p) => <p>{p}</p>)}
      </div>
    </Capsule>
    {a.rows.map((r) => (
      <Capsule class="row">
        <div class="row__text">
          <h3 class="row__h">{r.title}</h3>
          <div class="prose row__prose"><Fragment set:html={renderMarkdown(r.md)} /></div>
        </div>
        <ul class:list={['row__photos', `row__photos--${r.photos.length}`]} role="list">
          {r.photos.map((ph) => (
            <li><figure>
              <button type="button" class="row__zoom" data-zoom aria-label={`View larger: ${ph.alt}`}><img src={ph.src} alt={ph.alt} loading="lazy" /></button>
              {ph.caption && <figcaption>{ph.caption}</figcaption>}
            </figure></li>
          ))}
        </ul>
      </Capsule>
    ))}
  </Section>

  <Section heading={a.whyHeading} id="why-games">
    {a.whyBlocks.map((b) => b.masonry ? (
      <Capsule media>
        <ul class="masonry" role="list">
          {b.items.map((ph: { src: string; alt: string; caption?: string }) => (
            <li><figure>
              <button type="button" class="masonry__zoom" data-zoom aria-label={`View larger: ${ph.alt}`}>
                <img src={ph.src} alt={ph.alt} loading="lazy" />
              </button>
              {ph.caption && <figcaption class="media__caption">{ph.caption}</figcaption>}
            </figure></li>
          ))}
        </ul>
      </Capsule>
    ) : <Blocks blocks={[b]} />)}
  </Section>

  <Section heading="More Portfolios" id="more-portfolios">
    {a.portfoliosText && (
        <Capsule>
        <p class="ports">{a.portfoliosText}</p>
        <ul class="ports-list">
          {PORT_GROUPS.map((g) => (
            <li><b>{g.label}:</b>{' '}
              {g.items.map(([id, name], i) => {
                const p = portfolios.find((x) => x.id === id);
                return p && <Fragment>{i > 0 && ' '}<span class="ports__item">{i > 0 && <span class="ports__sep" aria-hidden="true">• </span>}<a href={p.href} aria-current={p.current ? 'page' : undefined}>{name}</a></span></Fragment>;
              })}
              {g.note && <span class="ports__note"> {g.note}</span>}
            </li>
          ))}
        </ul>
        </Capsule>
      )}
  </Section>
</Base>

<style>
  .about-intro__zoom { display: block; padding: 0; border: 0; background: none; cursor: zoom-in; border-radius: 24px; flex: 0 0 auto; align-self: center; }
  .about-intro__zoom img { display: block; transition: opacity 150ms ease; }
  .about-intro__zoom:hover img { opacity: 0.88; }
  .about-intro__zoom:focus-visible { outline: 3px solid var(--focus); outline-offset: 3px; }
  :global(.about-intro) { flex-direction: row !important; align-items: center; gap: 40px !important; }
  .about-intro__photo { flex: 0 0 280px; width: 280px; height: auto; aspect-ratio: 651 / 700; object-fit: cover; border-radius: 24px; }
  .about-intro__text { display: flex; flex-direction: column; gap: var(--para-gap); max-width: var(--text-w); }
  .about-intro__text p { margin: 0; font-size: var(--fs-body); line-height: var(--lh-prose); color: var(--text-body); }
  .ports a { color: var(--text); text-decoration: none; }
  .ports a:hover { color: #fff; text-decoration: underline; text-underline-offset: 4px; }
  .ports a[aria-current] { color: var(--muted-text); }
  .ports-list { margin: calc(var(--para-gap) - var(--stack-gap)) 0 0; padding-left: var(--list-indent); font-size: var(--fs-body); line-height: var(--lh-prose); color: var(--text-body); }
  .ports-list li + li { margin-top: var(--list-gap); }
  .ports-list b { color: var(--text); }
  .ports-list a { color: var(--text); text-decoration: none; }
  .ports-list a:hover { color: #fff; text-decoration: underline; text-underline-offset: 4px; }
  .ports-list a[aria-current] { color: var(--text); text-decoration: underline; text-underline-offset: 4px; }
  .ports__sep { color: var(--muted-text); }
  .ports__note { color: var(--muted-text); }
  .ports__item { white-space: nowrap; }
  .ports__sl { color: var(--magenta); font-weight: 700; }
  /* Topic rows: text left, photos right (stack on phones). Type matches the project pages. */
  :global(.row) { flex-direction: row !important; align-items: center; gap: 32px !important; }
  .row__text { flex: 1 1 0; min-width: 0; display: flex; flex-direction: column; gap: 12px; }
  .row__h { margin: 0; font: 900 var(--fs-subsection) / 1 var(--font-body); color: var(--text); }
  .row__prose :global(p) { margin: 0; }
  .row__prose { display: flex; flex-direction: column; gap: var(--para-gap); }
  .row__photos { flex: 0 0 50%; display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin: 0; padding: 0; list-style: none; }
  .row__photos--1 { flex-basis: 34%; grid-template-columns: 1fr; }
  .row__photos--3 li:first-child { grid-column: 1 / -1; }
  .row__photos figure { margin: 0; display: flex; flex-direction: column; gap: 8px; }
  .row__zoom { display: block; width: 100%; padding: 0; border: 0; background: none; cursor: zoom-in; }
  .row__photos img { display: block; width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 12px; }
  .row__photos--3 li:first-child img { aspect-ratio: 16 / 9; }
  .row__photos--1 img { aspect-ratio: 3 / 4; }
  .row__photos figcaption { text-align: center; font-size: 16px; line-height: var(--lh-compact); color: var(--text-body); }
  /* Whole photos, no crop (portraits stay whole), captions in the site's caption style. */
  .masonry { columns: 3; column-gap: var(--grid-gap); margin: 0; padding: 0; list-style: none; }
  .masonry li { break-inside: avoid; margin-bottom: var(--grid-gap); }
  .masonry figure { margin: 0; display: flex; flex-direction: column; gap: 12px; }
  .masonry__zoom { display: block; width: 100%; padding: 0; border: 0; background: none; cursor: zoom-in; }
  .masonry img { width: 100%; height: auto; display: block; }
  .masonry figcaption { text-align: center; font-size: var(--fs-body); line-height: var(--lh-compact); color: var(--text-body); }
  .made { display: block; color: inherit; text-decoration: none; border-radius: 4px; }
  .made:hover :global(.media__img) { opacity: 0.85; }
  .made:hover :global(.media__caption) { text-decoration: underline; text-underline-offset: 4px; }
  .made:focus-visible { outline: 3px solid var(--focus); outline-offset: 4px; }

  @media (max-width: 1279.98px) {
    :global(.about-intro) { gap: 28px !important; }
    .about-intro__photo { flex-basis: 220px; width: 220px; }
  }
  @media (max-width: 799.98px) {
    :global(.about-intro) { flex-direction: column !important; align-items: stretch; gap: 20px !important; }
    .about-intro__zoom { align-self: center; width: min(260px, 100%); }
    .about-intro__photo { width: 100%; flex-basis: auto; }
    :global(.row) { flex-direction: column !important; align-items: stretch; gap: 16px !important; }
    .row__photos, .row__photos--1 { flex-basis: auto; }
    .row__photos--1 { max-width: 320px; align-self: center; }
    .masonry { columns: 2; column-gap: 12px; }
    .masonry li { margin-bottom: 12px; }
    .masonry figcaption { font-size: 15px; }
  }
</style>
