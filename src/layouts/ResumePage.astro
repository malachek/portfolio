---
/**
 * A role's /resume page: that role's resume PDF, embedded from Google Drive
 * (roles/<role>.yaml → resumeDriveId). Falls back to the generalist resume.
 */
import Base from '@/layouts/Base.astro';
import { APEX_ROLE, absUrl, getRole, type Role } from '@/lib/content';
interface Props { role: Role }
const { role } = Astro.props;
const fallback = (await getRole(APEX_ROLE)).data.resumeDriveId;
const driveId = role.data.resumeDriveId ?? fallback;
const drivePreview = `https://drive.google.com/file/d/${driveId}/preview`;
---
<Base title="Resume | Malachy Kennedy" description="Malachy Kennedy's resume: gameplay and systems engineer, UE5 and Unity, two titles shipped on Steam." canonical={absUrl(role, '/resume')} roleId={role.id}>
  <section class="wrap resume">
    <h1 class="visually-hidden">Resume</h1>
    <iframe src={drivePreview} title="Malachy Kennedy resume (PDF)" loading="eager"></iframe>
  </section>
</Base>

<style>
  .resume { padding-block: 24px 48px; }
  .resume iframe { width: 100%; height: min(1200px, 85vh); border: 0; border-radius: 8px; background: #fff; }
</style>
