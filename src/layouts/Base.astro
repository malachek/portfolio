---
/**
 * Page shell: <head> metadata, self-hosted fonts, skip link, header, <main>, footer.
 * Every page (every role variant) renders through this.
 */
import '@/styles/fonts.css';
import '@/styles/global.css';

import { getEntry } from 'astro:content';
import Header from '@/components/site/Header.astro';
import Footer from '@/components/site/Footer.astro';
import Lightbox from '@/components/media/Lightbox.astro';
import Intro from '@/components/site/Intro.astro';
import { APEX_ROLE, getRole, href } from '@/lib/content';
import { accentVars } from '@/lib/color';

interface Props {
  title: string;
  description: string;
  /** Absolute canonical URL for this page on its own variant's host. */
  canonical?: string;
  ogImage?: string;
  /** Which role site this page belongs to (default: the generalist apex). */
  roleId?: string;
  /** Unused since the role switcher moved into the header (kept for callers). */
  lens?: boolean;
  noindex?: boolean;
  /** Page accent (#rrggbb): rules, pills, chips. Defaults to magenta. */
  accent?: string;
}

const {
  title,
  description,
  canonical,
  ogImage,
  roleId = APEX_ROLE,
  noindex = false,
  accent,
} = Astro.props;

const site = (await getEntry('site', 'site'))!.data;
const role = await getRole(roleId);
const homeHref = href(roleId, '/');
const nav = site.nav.map((n) => ({ ...n, href: href(roleId, n.href === 'resume' ? role.data.resume : n.href) }));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <!-- First page of a visit: cover the page until fonts and hero art are in (Intro.astro). -->
    <script is:inline>try{if(!sessionStorage.getItem('mk-intro'))document.documentElement.classList.add('is-intro')}catch(e){}</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#010210" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <link rel="preload" href="/fonts/roboto-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/roboto-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/jersey-10-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/icons/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <slot name="head" />
  </head>
  <body style={accent ? accentVars(accent) : undefined}>
    <Intro />
    <a class="skip-link" href="#main">Skip to main content</a>
    <Header name={site.name} github={site.github} linkedin={site.linkedin} nav={nav} homeHref={homeHref} roleId={roleId} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer
      name={site.name}
      email={site.email}
      github={site.github}
      linkedin={site.linkedin}
      availability={site.availability}
      nav={nav}
      homeHref={homeHref}
    />
    <Lightbox />
  </body>
</html>

<style>
  main:focus { outline: none; }
</style>
