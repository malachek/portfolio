---
/**
 * Page shell: <head> metadata, self-hosted fonts, skip link, header, <main>, footer.
 * Every page (every role variant) renders through this.
 */
import '@fontsource/roboto/400.css';
import '@fontsource/roboto/500-italic.css';
import '@fontsource/roboto/700.css';
import '@fontsource/roboto/700-italic.css';
import '@fontsource/roboto/900.css';
import '@fontsource/jersey-10/400.css';
import '@/styles/global.css';

import { getEntry } from 'astro:content';
import Header from '@/components/site/Header.astro';
import Footer from '@/components/site/Footer.astro';

interface Props {
  title: string;
  description: string;
  /** Absolute canonical URL for this page on its own variant's host. */
  canonical?: string;
  ogImage?: string;
  /** Resolved href for the nav "Resume" link (the role's PDF). */
  resumeHref?: string;
  homeHref?: string;
  noindex?: boolean;
  /** Page accent (#rrggbb): rules, pills, chips. Defaults to magenta. */
  accent?: string;
}

const {
  title,
  description,
  canonical,
  ogImage,
  resumeHref = '/resume',
  homeHref = '/',
  noindex = false,
  accent,
} = Astro.props;

const site = (await getEntry('site', 'site'))!.data;
const nav = site.nav.map((n) => ({ ...n, href: n.href === 'resume' ? resumeHref : n.href }));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#010210" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <slot name="head" />
  </head>
  <body style={accent ? `--accent:${accent}` : undefined}>
    <a class="skip-link" href="#main">Skip to main content</a>
    <Header name={site.name} github={site.github} linkedin={site.linkedin} nav={nav} homeHref={homeHref} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer
      name={site.name}
      email={site.email}
      github={site.github}
      linkedin={site.linkedin}
      availability={site.availability}
      nav={nav}
      homeHref={homeHref}
    />
  </body>
</html>

<style>
  main:focus { outline: none; }
</style>
