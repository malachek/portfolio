---
/**
 * A role's homepage: hero, Selected Work cards, Also Built, experience cards,
 * skills. Content: src/content/roles/<role>.yaml plus each project's card data.
 */
import Base from '@/layouts/Base.astro';
import HomeHero from '@/components/home/HomeHero.astro';
import Section from '@/components/layout/Section.astro';
import FeatureCard from '@/components/home/FeatureCard.astro';
import AlsoBuilt from '@/components/home/AlsoBuilt.astro';
import Skills from '@/components/home/Skills.astro';
import { absUrl, resolveHome, type Role } from '@/lib/content';

interface Props { role: Role }
const { role } = Astro.props;
const home = await resolveHome(role);
---
<Base title={role.data.seo.title} description={role.data.seo.description} canonical={absUrl(role, '/')} roleId={role.id}>
  <HomeHero title={home.hero.title} lines={home.hero.lines} bullets={home.hero.bullets} tiles={home.hero.tiles} background={home.hero.background} />

  <Section heading={home.selectedWorkHeading} id="projects" fullBleed>
    <div class="cards">
      {home.featured.map((c) => <FeatureCard {...c} />)}
    </div>
    {home.alsoBuilt.length > 0 && <AlsoBuilt label={home.alsoBuiltLabel} cards={home.alsoBuilt} />}
  </Section>

  {home.experience.filter((g) => g.cards.length > 0).map((group) => (
    <Section heading={group.heading} fullBleed>
      <div class="cards">
        {group.cards.map((c) => <FeatureCard {...c} />)}
      </div>
    </Section>
  ))}

  <Skills heading={home.skills.heading} groups={home.skills.lines} />
</Base>

<style>
  .cards { display: flex; flex-direction: column; gap: 24px; }
</style>
