---
/**
 * A project / experience page: hero, overview capsule, then its sections.
 * Takes the merged page data (base + role overlay once step 3 lands).
 */
import type { CollectionEntry } from 'astro:content';
import Base from '@/layouts/Base.astro';
import ProjectHero from '@/components/project/ProjectHero.astro';
import OverviewCapsule from '@/components/project/OverviewCapsule.astro';
import Section from '@/components/layout/Section.astro';
import Lead from '@/components/layout/Lead.astro';
import Blocks from '@/components/project/Blocks.astro';

interface Props {
  page: CollectionEntry<'projects'>['data'];
  canonical?: string;
}
const { page, canonical } = Astro.props;
---
<Base title={page.seo.title} description={page.seo.description} canonical={canonical} accent={page.accent}>
  <ProjectHero
    title={page.title}
    lines={page.hero.lines}
    background={page.hero.background}
    logo={page.hero.logo}
    logoAlt={page.hero.logoAlt ?? `${page.title} logo`}
  />
  {page.overview && (
    <OverviewCapsule
      heading={page.overview.heading}
      rows={page.overview.rows}
      steamAppIds={page.overview.steamAppIds}
      code={page.overview.code}
    />
  )}
  {page.sections.map((s) => (
    <Section heading={s.heading} id={s.id}>
      {s.lead && <Lead>{s.lead}</Lead>}
      <Blocks blocks={s.blocks} />
    </Section>
  ))}
</Base>
